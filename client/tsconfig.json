{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@photrix/api-contract": ["../shared/api-contract/src/index.ts"],
      "@photrix/feature-flags": ["../shared/feature-flags/src/featureFlags.ts"],
      "@photrix/filter-contract": ["../shared/filter-contract/src/index.ts"],
      "@photrix/hls-segment-headers": ["../shared/hls-segment-headers/src/index.ts"],
      "@photrix/video-storyboard": ["../shared/video-storyboard/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
