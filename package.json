{
  "name": "photrix",
  "version": "1.0.0",
  "description": "A new way to enjoy your memories",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "trustedDependencies": [
    "sharp",
    "esbuild"
  ],
  "scripts": {
    "bootstrap": "bun install && node scripts/setup-native.mjs",
    "build:client": "bun run --filter photrix-client build",
    "build:server": "bun run --filter server build",
    "dev:client": "bun run --filter photrix-client dev",
    "dev:server": "bun run --filter server dev",
    "test": "bun run --filter server test",
    "test:e2e": "bun run --filter photrix-e2e test",
    "test:e2e:install": "bun run --filter photrix-e2e install:browsers",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "trace:jaeger": "powershell -ExecutionPolicy Bypass -File ./scripts/start-jaeger.ps1",
    "tunnel:test": "powershell -ExecutionPolicy Bypass -File ./scripts/start-test-tunnels.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottdrichards/photrix.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/scottdrichards/photrix/issues"
  },
  "homepage": "https://github.com/scottdrichards/photrix#readme"
}
