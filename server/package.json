{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "bun run build && bun run start:built",
    "start:built": "MALLOC_ARENA_MAX=2 node --max-old-space-size=1024 dist/server/src/main.js",
    "dev": "tsx src/main.ts",
    "db:vacuum": "node scripts/vacuum-db.mjs",
    "mcp": "tsx src/mcp/main.ts",
    "python:install": "node scripts/python-env.mjs install",
    "python:report": "node scripts/python-env.mjs report",
    "python:profiles": "node scripts/python-env.mjs list",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:python": "cd python && ${PHOTRIX_PYTHON:-python3} -m unittest discover -p '*_test.py'",
    "test:scripts": "node --test scripts/",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "predev": "node ../scripts/setup-native.mjs",
    "prebuild": "node ../scripts/setup-native.mjs",
    "pretest": "node ../scripts/setup-native.mjs"
  },
  "ts-node": {
    "esm": true
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@simplewebauthn/server": "^13.3.2",
    "better-sqlite3": "^12.5.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "minimatch": "^9.0.4",
    "pino": "^10.3.1",
    "sharp": "^0.33.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.44.1"
  }
}
