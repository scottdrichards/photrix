# Photrix server configuration. Copy this file to .env and adjust it.
#
# Generated from server/src/config/config.ts by `bun run --filter server env:example`;
# edit the help text there, not here. A commented-out line shows the default,
# or an example where there is none.

# --- Media library and cache ---

# Required. The folder of photos and videos to index. ./exampleFolder is a small
# synthetic library for trying things out and for tests.
MEDIA_ROOT=./exampleFolder

# Where thumbnails, converted media and downloaded models are cached, and the
# database's default location. Defaults to ./.cache under the working directory.
CACHE_DIR=./.cache

# Size of the media cache (thumbnails, converted images and videos) before
# least-recently-used entries are evicted, down to 90% of it. A byte count or a
# size like "10GB". The database, model downloads and grid thumbnails are never
# evicted.
# CACHE_MAX_BYTES=10GB

# How often the cache eviction sweep runs (ms).
# CACHE_EVICTION_INTERVAL_MS=300000

# How often to rescan recently changed folders (ms). Catches writes the file
# watcher misses, such as ones made to a network share from another machine.
# FILE_SYSTEM_RESCAN_INTERVAL_MS=300000

# How many image and video conversions run at once.
# PHOTRIX_MEDIA_CONVERSION_CONCURRENCY=2

# The grid-thumbnail backfill pre-generates every grid tile, newest first, as
# the lowest-priority background work. This caps its reads from the library, in
# MB/s.
# PHOTRIX_THUMBNAIL_BACKFILL_MB_PER_SEC=10

# The backfill waits while the 1-minute load per CPU is above this.
# PHOTRIX_THUMBNAIL_BACKFILL_MAX_LOAD=0.5

# --- Database ---

# Folder for the SQLite database (index.db). Defaults to CACHE_DIR. Must be a
# local disk: SQLite's WAL mode doesn't work over SMB or other network
# filesystems, where the read worker hangs while the write worker is busy.
# INDEX_DB_LOCATION=./.cache

# SQLite read workers. Each is a thread with its own connection and page cache.
# PHOTRIX_DB_READ_WORKERS=2

# How often (ms) a blocking WAL checkpoint writes committed pages back into
# index.db and truncates the WAL. Background reads starve SQLite's passive
# checkpoints, so without this the WAL grows without bound. 0 turns it off.
# PHOTRIX_WAL_CHECKPOINT_INTERVAL_MS=60000

# --- Server and logging ---

# HTTP port. 0 picks a free one.
# PORT=3000

# "production" switches the log to JSON at info level; anything else is
# pretty-printed at debug level.
# NODE_ENV=development

# Log threshold: fatal, error, warn, info, debug, trace, silent. Defaults to
# info in production, debug otherwise.
# LOG_LEVEL=info

# The public origin people open the app at. Share-link previews and links
# returned by the MCP server point here. Defaults to the request's own origin
# for previews, and to PHOTRIX_BASE_URL for MCP links.
# PHOTRIX_PUBLIC_URL=https://photos.example.com

# Requests slower than this (ms) are recorded as server.request.slow diagnostics
# events with their span breakdown (documentation/DIAGNOSTICS.md).
# PHOTRIX_SLOW_REQUEST_MS=1000

# Spans shorter than this (ms) are left out of the per-request console lines.
# PHOTRIX_TRACE_SPAN_MIN_MS=25

# Interval (ms) for the periodic heap and RSS log line. 0 turns it off.
# PHOTRIX_MEMORY_LOG_INTERVAL_MS=600000

# --- Sign-in ---
#
# With neither AUTH_PASSWORD nor PHOTRIX_ACCOUNTS set, the app is open to anyone
# who can reach it.

# Single-account mode: the password for the account "admin".
# AUTH_PASSWORD=

# Several accounts, as a JSON array: [{"username":"alice","password":"…"}].
# Takes precedence over AUTH_PASSWORD.
# PHOTRIX_ACCOUNTS=

# Required when sign-in is on: the key share links are encrypted with. A random
# string of at least 32 characters, e.g. `openssl rand -base64 32`. Not the
# password: every share link carries ciphertext under this key, so a
# password-derived key would let a link holder test password guesses offline.
# Changing it invalidates every share link.
# PHOTRIX_SHARE_TOKEN_SECRET=

# A session expires after this many days without use.
# PHOTRIX_SESSION_EXPIRY_DAYS=30

# The WebAuthn relying-party origin for passkeys: your public origin. Until it
# points at a public domain the passkeys section stays hidden, because a passkey
# bound to localhost or a LAN address only works from that one network. Defaults
# to http://localhost:<PORT>.
# PHOTRIX_RP_ORIGIN=https://photos.example.com

# Password hashes in flight at once. Past this a login waits in a queue.
# PHOTRIX_LOGIN_MAX_CONCURRENT=2

# Logins that may wait for a hash. Past this a login is refused.
# PHOTRIX_LOGIN_MAX_QUEUED=16

# Failed logins allowed per client IP per 15 minutes. Generous, because visitors
# behind one proxy share an address.
# PHOTRIX_LOGIN_MAX_FAILURES=20

# Account → Active sessions shows a rough place for sessions from the internet,
# looked up from a public IP-location service (ipapi.co). Local-network
# addresses are never sent. "off" keeps visitors' addresses on this server.
# PHOTRIX_IP_LOCATION=on

# --- Search ---

# How long a search, or resolving a semantic share link, waits on any one source
# (CLIP, CLAP, transcripts) before answering without it (ms).
# PHOTRIX_SEARCH_TIMEOUT_MS=15000

# Lowest CLIP image-text similarity a result may have.
# PHOTRIX_SEARCH_CLIP_MIN_SIMILARITY=0.18

# Lowest CLAP audio-text similarity a result may have. Defaults to 0.52 for
# searches and 0.45 for semantic share links.
# PHOTRIX_SEARCH_CLAP_MIN_SIMILARITY=0.52

# Deadline (ms) for the local LLM to turn a typed search into filters (needs
# PHOTRIX_OLLAMA_URL). Missing it costs only the filter chips: the plain search
# has already run.
# PHOTRIX_NL_SEARCH_TIMEOUT_MS=12000

# --- Local LLM (Ollama) ---
#
# Generates share-link titles, photo captions and search filters. With
# PHOTRIX_OLLAMA_URL unset each falls back to its deterministic behaviour.

# Base URL of an Ollama instance.
# PHOTRIX_OLLAMA_URL=http://localhost:11434

# Text model for share titles and search filters. A small instruct model is
# plenty and leaves GPU memory free.
# PHOTRIX_OLLAMA_MODEL=llama3.2:3b

# Per-request timeout (ms) for a share title.
# PHOTRIX_OLLAMA_TIMEOUT_MS=15000

# How long Ollama keeps the model loaded after a call. A cold call spends most
# of its time loading the model, so letting it idle out makes nearly every
# request pay that again. 0 frees the memory at once.
# PHOTRIX_OLLAMA_KEEP_ALIVE=30m

# Vision model for photo captions and descriptions.
# PHOTRIX_OLLAMA_VISION_MODEL=moondream:latest

# Per-request timeout (ms) for a short caption.
# PHOTRIX_OLLAMA_CAPTION_TIMEOUT_MS=40000

# Total deadline (ms) for a long photo description. Long, because a contended
# GPU pushes the model onto the CPU.
# PHOTRIX_OLLAMA_DESCRIPTION_TIMEOUT_MS=600000

# --- Video playback (HLS) ---

# Folder for HLS output. It is made on demand and deleted shortly after playback
# stops, so it defaults to a RAM-backed filesystem (/dev/shm, else the OS temp
# folder). Don't point it at persistent disk.
# HLS_CACHE_DIR=/dev/shm/photrix-hls

# How long (ms) a video's HLS output is kept after its last request before every
# encode is killed and the folder deleted.
# PHOTRIX_HLS_IDLE_MS=90000

# How long (ms) one encode may go untouched (after an ABR switch or a seek)
# before it is killed.
# PHOTRIX_HLS_VARIANT_IDLE_MS=8000

# How many segments past an encode's head a request may be before a new encode
# starts at the request instead of waiting.
# PHOTRIX_HLS_SEEK_RESTART_GAP=10

# Encodes one quality of one video may run at once. Past this the least recently
# used goes.
# PHOTRIX_HLS_MAX_RUNS_PER_VARIANT=3

# An encode this many segments ahead of the furthest one requested is paused
# until the player catches up.
# PHOTRIX_HLS_PACE_AHEAD_SEGMENTS=30

# --- Python and ML workers ---

# The Python interpreter for image conversion and the ML workers. Defaults to
# ./.venv, then python3 (python on Windows). The day-photo and screensaver
# scripts fall back to python3.
# PHOTRIX_PYTHON=./.venv/bin/python

# Older name for PHOTRIX_PYTHON, used by the ML workers when PHOTRIX_PYTHON is
# unset.
# PHOTRIX_PYTHON_EXECUTABLE=

# 1 stops the audio workers (Whisper transcription, CLAP audio search) from ever
# starting. An emergency switch for a GPU too small to hold them.
# PHOTRIX_DISABLE_AUDIO=0

# How long (ms) the image-analysis worker (faces and CLIP) may take to load its
# models.
# PHOTRIX_IMAGE_WORKER_READY_TIMEOUT_MS=300000

# How long (ms) the CLAP audio worker may take to load.
# PHOTRIX_CLAP_READY_TIMEOUT_MS=300000

# How long (ms) the Whisper worker may take to load.
# PHOTRIX_WHISPER_READY_TIMEOUT_MS=300000

# Whisper is unloaded after this long (ms) without work.
# PHOTRIX_WHISPER_IDLE_UNLOAD_MS=60000

# How long (ms) the app must go unused before Whisper may load. Loading it takes
# ~30 s and ~2 GB, so starting it in every pause between requests only to kill
# it at the next one wastes both.
# PHOTRIX_WHISPER_START_QUIET_MS=60000

# Torch device for the torch workers (cuda, mps, xpu, cpu). The startup
# accelerator probe sets it when unset.
# PHOTRIX_TORCH_DEVICE=cuda

# CLIP's device. Defaults to the probed torch device.
# PHOTRIX_CLIP_DEVICE=cuda

# CLAP's device. Defaults to PHOTRIX_TORCH_DEVICE.
# PHOTRIX_CLAP_DEVICE=cpu

# ONNX Runtime provider for the face models. Defaults to the probed provider,
# using CUDA only when torch is on CUDA too.
# PHOTRIX_INSIGHTFACE_PROVIDER=CPUExecutionProvider

# Older name for PHOTRIX_INSIGHTFACE_PROVIDER.
# PHOTRIX_CLIP_PROVIDER=

# Free GPU memory (MiB) CLAP needs before it takes the GPU instead of the CPU.
# PHOTRIX_CLAP_MIN_FREE_GPU_MIB=1024

# Longest edge (px) images are decoded at for face detection and CLIP.
# PHOTRIX_IMAGE_MAX_DECODE_EDGE=2048

# CPU threads for Whisper when it runs on the CPU.
# WHISPER_CPU_THREADS=2

# --- Background work ---

# Under load, background work runs in bursts instead of stopping. Length of a
# burst (ms).
# PHOTRIX_BG_DUTY_ON_MS=2000

# Rest between bursts (ms).
# PHOTRIX_BG_DUTY_OFF_MS=2000

# Longest (ms) one user request may hold background work stopped without
# refreshing. Past this the hold is dropped and logged, so a leak can't freeze
# indexing.
# PHOTRIX_USER_LEASE_MAX_MS=600000

# New background work holds off while the 1-minute load per CPU is above this.
# PHOTRIX_LOAD_THRESHOLD=0.9

# --- Feature flags ---
#
# Each pins its flag to "true" or "false"; unset, it follows Status → Feature
# flags.

# Pre-generate grid thumbnails for the whole library in the background, newest
# first. Default true.
# PHOTRIX_FLAG_THUMBNAIL_BACKFILL=true

# --- MCP server ---
#
# Lets AI agents query the library. It proxies the HTTP API, so it can run on
# another host (`bun run --filter server mcp`). See src/mcp/README.md.

# Start the MCP server inside the main server. false when it runs standalone
# elsewhere.
# MCP_AUTOSTART=true

# Port the MCP server listens on (Streamable HTTP at /mcp). 0 picks a free one.
# MCP_PORT=3100

# Base URL of the Photrix HTTP server the MCP server proxies.
# PHOTRIX_BASE_URL=http://localhost:3000

# The Photrix bearer the MCP server uses in shared-secret mode (MCP_AUTH_TOKEN
# set). In per-user mode each caller sends their own MCP key from the account
# panel instead.
# PHOTRIX_TOKEN=

# Legacy shared secret for the MCP endpoint. When set, callers send it as a
# bearer and the server reaches Photrix with PHOTRIX_TOKEN. Leave unset for
# per-user keys.
# MCP_AUTH_TOKEN=

# Per-request timeout (ms) when the MCP server calls Photrix.
# PHOTRIX_MCP_TIMEOUT_MS=30000

# --- Tracing (OpenTelemetry) ---

# Export request and operation spans over OTLP HTTP (Jaeger all-in-one accepts
# them on port 4318).
PHOTRIX_OTEL_ENABLED=false

# OTLP traces endpoint.
# PHOTRIX_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# The standard OpenTelemetry name for the same setting, used when the one above
# is unset.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
