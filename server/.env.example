# Sample configuration for the Photrix media server
# Copy this file to `.env` and adjust the paths to match your environment.

# Root directory containing media files to index
MEDIA_ROOT=./exampleFolder

# Optional: Directory for the SQLite database file (uses <INDEX_DB_LOCATION>/index.db)
# If omitted, defaults to CACHE_DIR (or ./.cache when CACHE_DIR is also unset).
# IMPORTANT: this MUST be a local disk. SQLite uses WAL mode here, which does
# not work over SMB / network filesystems — the read worker hangs indefinitely
# whenever the write worker is active. Keep CACHE_DIR on the network share if
# you want; just point INDEX_DB_LOCATION at a local path.
# INDEX_DB_LOCATION=./.cache

# How often (ms) to run a blocking WAL checkpoint that writes committed frames
# back into index.db and truncates the WAL file. Default 60000 (60s). Passive
# autocheckpoints get starved by the constant background read load, so without
# this sweep the WAL grows without bound (observed at ~1 GB). Set to 0 to disable.
# PHOTRIX_WAL_CHECKPOINT_INTERVAL_MS=60000

# Current baseline matching active `.env` keys (sanitized values)
CACHE_DIR=./.cache

# Maximum size of the media cache (thumbnails / converted images & videos) before
# least-recently-used entries are evicted. Accepts a plain byte count or a suffix
# (KB/MB/GB/TB), e.g. "10GB". Defaults to 10GB. Eviction trims down to 90% of this
# value once exceeded. Only the media cache is affected — the database and model
# downloads under CACHE_DIR are never touched.
# CACHE_MAX_BYTES=10GB

# How often (ms) the cache eviction sweep runs. Default 300000 (5 minutes).
# CACHE_EVICTION_INTERVAL_MS=300000

# Directory for ephemeral HLS output. HLS is generated on demand for video playback
# and deleted shortly after playback stops, so it never accumulates. It defaults to a
# RAM-backed filesystem (/dev/shm on Linux, otherwise the OS temp dir) and should NOT
# point at persistent disk. Override only if /dev/shm is unavailable or too small.
# HLS_CACHE_DIR=/dev/shm/photrix-hls

# How long (ms) an HLS encode/output is kept after the last segment request before it
# is killed and deleted. Default 90000 (90s).
# PHOTRIX_HLS_IDLE_MS=90000

PHOTRIX_OTEL_ENABLED=false
# PHOTRIX_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Server port (default: 3000)
# PORT=3000

# Directory for caching thumbnails and processed files
# CACHE_DIR=./.cache

# Directory for thumbnail cache specifically
# ThumbnailCacheDirectory=./.cache/thumbs

# Optional: Path to a working Python interpreter used for image conversion/thumbnail generation.
# On Windows, prefer the `py` launcher or a full path to python.exe from a python.org install.
# PHOTRIX_PYTHON=C:\\Users\\you\\AppData\\Local\\Programs\\Python\\Python312\\python.exe
# PHOTRIX_PYTHON=py

# Optional: ONNX Runtime provider used by the local InsightFace worker.
# Defaults to CUDA when the server detects both CUDA and the ONNX CUDA provider,
# otherwise CPU.
# PHOTRIX_INSIGHTFACE_PROVIDER=CPUExecutionProvider

# Optional: CLIP device for image/text embeddings. Defaults to CUDA when the
# server detects it at startup, otherwise CPU.
# PHOTRIX_CLIP_DEVICE=cuda

# The server's public origin, used as the WebAuthn relying-party origin for
# passkeys. Passkeys only make sense once this points at your actual public
# domain (e.g. https://photos.example.com) — without it, the account settings
# passkeys section stays hidden, since there is no stable public identity to
# bind a passkey to on a bare LAN/localhost deployment. Defaults to
# http://localhost:<PORT>, which is treated as "not public" (LAN/localhost
# hostnames don't enable the passkeys section).
# PHOTRIX_RP_ORIGIN=https://photos.example.com

# --- MCP server ---
# The Photrix MCP server lets AI agents query the library (semantic search, face
# recognition, "on this day", metadata filters). It proxies the Photrix HTTP API,
# so it can run on a different host. See src/mcp/README.md.
#
# It starts in-process automatically alongside the main app (`npm start`) —
# no separate `npm run mcp` process needed for the common case. Set this to
# "false" to opt out of the autostart (e.g. you're running MCP standalone on a
# different host and don't want this instance's copy competing for MCP_PORT).
# MCP_AUTOSTART=true

# Port the MCP server listens on (Streamable HTTP at /mcp). Default 3100.
# MCP_PORT=3100

# Base URL of the Photrix HTTP server the MCP server proxies. Default http://localhost:3000.
# PHOTRIX_BASE_URL=http://localhost:3000

# Default Photrix bearer, used only when a caller sends no key of their own.
# In per-user mode (MCP_AUTH_TOKEN unset) each caller instead sends their own
# personal MCP key (generated in the web app's account panel), which the MCP
# server forwards to Photrix. Obtain a raw token via POST /api/auth/login.
# PHOTRIX_TOKEN=

# Legacy shared-secret gate for the MCP endpoint. When set, callers must send
# `Authorization: Bearer <MCP_AUTH_TOKEN>` and the server talks to Photrix using
# PHOTRIX_TOKEN. Leave unset to use per-user MCP keys (recommended).
# MCP_AUTH_TOKEN=

# Per-request timeout (ms) when the MCP server calls Photrix. Default 30000.
# PHOTRIX_MCP_TIMEOUT_MS=30000

# --- Observability / Tracing ---

# Enable OpenTelemetry trace export. When enabled, request and operation spans are
# exported over OTLP HTTP. Jaeger all-in-one can receive this on port 4318.
# PHOTRIX_OTEL_ENABLED=true

# Optional OTLP traces endpoint override.
# PHOTRIX_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional logging threshold for per-span console lines.
# PHOTRIX_TRACE_SPAN_MIN_MS=25

# Number of slow spans included in request completion summaries.
# PHOTRIX_TRACE_TOP_SPANS=8

# --- Share-link descriptions (local LLM) ---

# Base URL of a locally hosted Ollama instance. When set, share links get a short
# generated album title (used as the link-preview headline) instead of the raw
# filter summary. Leave unset to disable — the deterministic filter summary is
# used instead and share links still work.
# PHOTRIX_OLLAMA_URL=http://192.168.1.160:11434

# Model used for share titles. Small instruct models are plenty for a one-line
# title and keep GPU memory free. Default llama3.2:3b.
# PHOTRIX_OLLAMA_MODEL=llama3.2:3b

# Per-request timeout (ms) for the title generation. Default 15000.
# PHOTRIX_OLLAMA_TIMEOUT_MS=15000

# How long Ollama holds the model in memory after a call. Measured here, a cold
# call costs ~14.4s of which ~11.9s is just loading the model, so letting it
# idle out makes nearly every request pay that again. Default 30m; set to 0 to
# free the memory immediately if the Ollama host needs it for something else.
# PHOTRIX_OLLAMA_KEEP_ALIVE=30m

# --- Natural-language search ---
#
# The same Ollama instance (PHOTRIX_OLLAMA_URL above) also turns a typed search
# like "photos of Sarah at the beach last summer" into structured filters
# (people, date range, folder, media type, rating) plus the leftover text for
# CLIP. It is purely additive: with PHOTRIX_OLLAMA_URL unset — or the model down,
# slow, or answering with nonsense — the search bar behaves exactly as it always
# has and runs the query as a plain semantic search.
#
# Deadline (ms) for one interpretation. Missing it costs only the filter chips —
# the plain search has already run — so this is sized to the Ollama host: it was
# measured at 4-11s for even a trivial prompt under load. Lower it on a fast box
# for snappier chips, raise it if interpretations rarely land. Default 12000.
# PHOTRIX_NL_SEARCH_TIMEOUT_MS=12000
